# As `$` frequently appears in CurseForge API keys, wrap the value in single quotes.
# When using double quotes, escape each `$` as `\$`.
SJMCL_CURSEFORGE_API_KEY = ''

# Project custom dev toolbar
NEXT_PUBLIC_DEV_TOOLBAR = 'true'

# Update service (iOS Club "Downloader" install center) used by the launcher updater.
# Base URL of the deployed WebApi without a trailing slash, e.g. https://download.example.com
# Leave empty to disable launcher update checking.
XJMC_UPDATE_BASE = ''
# Id of this client's application record in the update service.
XJMC_UPDATE_APP_ID = ''
